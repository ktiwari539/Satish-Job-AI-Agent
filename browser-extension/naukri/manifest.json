{
  "manifest_version": 3,
  "name": "Satish Job Agent - Chrome Bridge",
  "version": "0.5.0",
  "description": "User-invoked Naukri and Indeed job capture and read-only application inspection.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://*.naukri.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
